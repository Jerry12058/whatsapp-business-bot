# These are entered into Vercel's "Environment Variables" settings, NOT uploaded as a real file.

# Any secret word you choose yourself (you'll type this same word into Meta's dashboard too)
VERIFY_TOKEN=choose_any_secret_word_here

# From Meta Developer Console > WhatsApp > API Setup
WHATSAPP_TOKEN=your_temporary_or_permanent_access_token
PHONE_NUMBER_ID=your_phone_number_id

# From Airtable (Account > Developer Hub > Personal access tokens)
AIRTABLE_TOKEN=your_airtable_personal_access_token
# From your Airtable base's URL or API docs page
AIRTABLE_BASE_ID=your_airtable_base_id
# The name of the table where messages will be saved (must match exactly)
AIRTABLE_TABLE_NAME=Customers
