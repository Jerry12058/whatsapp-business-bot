# Copy this file's contents into Render's "Environment Variables" settings later.
# Do NOT put real secrets in this .env.example file itself.

# Any secret word you choose yourself (you'll type this same word into Meta's dashboard too)
VERIFY_TOKEN=choose_any_secret_word_here

# From Meta Developer Console > WhatsApp > API Setup
WHATSAPP_TOKEN=your_temporary_or_permanent_access_token

# From Meta Developer Console > WhatsApp > API Setup
PHONE_NUMBER_ID=your_phone_number_id

PORT=3000
